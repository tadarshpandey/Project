# WasteTrack Backend Configuration

# Django Settings
SECRET_KEY=django-insecure-wastetrack-dev-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS Settings (frontend origins permitted to connect)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL_ORIGINS=True

# Database Configuration (PostgreSQL)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
# If DATABASE_URL is left empty or Postgres is not reachable, the app gracefully falls back to local SQLite3.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wastetrack_db

# Alternative individual PostgreSQL settings:
DB_NAME=wastetrack_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
